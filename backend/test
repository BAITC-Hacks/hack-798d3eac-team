        response = self.client.post(
            "/proposals/",
            data=json.dumps(data),
            content_type="application/json"
        )

        self.assertEqual(response.status_code, 400)

        self.assertEqual(
            Proposal.objects.count(),
            0
        )

    def test_proposal_missing_required_fields(self):
        data = {
            "task_id": self.task.id,
            "team_id": self.team.id
        }

        response = self.client.post(
            "/proposals/",
            data=json.dumps(data),
            content_type="application/json"
        )

        self.assertEqual(response.status_code, 400)


class ProposalDecisionTest(TestCase):

    def setUp(self):
        self.task = Task.objects.create(
            title="Проект",
            is_published=True
        )

        self.team = Team.objects.create(
            name="Team"
        )

        self.proposal = Proposal.objects.create(
            task=self.task,
            team=self.team,
            idea="Идея проекта",
            plan="План проекта",
            duration="2 месяца"
        )

    def test_accept_proposal(self):
        data = {
            "status": "accepted"
        }

        response = self.client.post(
            f"/proposals/{self.proposal.id}/decision/",
            data=json.dumps(data),
            content_type="application/json"
        )

        self.assertEqual(response.status_code, 200)

        self.proposal.refresh_from_db()

        self.assertEqual(
            self.proposal.status,
            Proposal.Status.ACCEPTED
        )

    def test_reject_proposal(self):
        data = {
            "status": "rejected"
        }

        response = self.client.post(
            f"/proposals/{self.proposal.id}/decision/",
            data=json.dumps(data),
            content_type="application/json"
        )

        self.assertEqual(response.status_code, 200)

        self.proposal.refresh_from_db()

        self.assertEqual(
            self.proposal.status,
            Proposal.Status.REJECTED
        )

    def test_invalid_decision(self):
        data = {
            "status": "something_wrong"
        }

        response = self.client.post(
            f"/proposals/{self.proposal.id}/decision/",
            data=json.dumps(data),
            content_type="application/json"
        )

        self.assertEqual(response.status_code, 400)


class PublishTaskTest(TestCase):

    def test_publish_unconfirmed_task(self):
        task = Task.objects.create(
            title="Тестовая задача",
            is_confirmed=False
        )

        response = self.client.post(
            f"/tasks/{task.id}/publish/"
        )

        self.assertEqual(response.status_code, 400)

        task.refresh_from_db()

        self.assertFalse(task.is_published)

    def test_publish_confirmed_task(self):
        task = Task.objects.create(
            title="Готовая задача",
            is_confirmed=True
        )

        response = self.client.post(
            f"/tasks/{task.id}/publish/"
        )

        self.assertEqual(response.status_code, 200)

        task.refresh_from_db()

        self.assertTrue(task.is_published)
