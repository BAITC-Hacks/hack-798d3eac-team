class TaskModelTest(TestCase):

    def test_create_task(self):
        task = Task.objects.create(
            title="Создание сайта",
            industry="IT",
            context="Нужно создать сайт",
            need="Разработка веб-приложения",
            expected_result="Готовый сайт"
        )

        self.assertEqual(task.title, "Создание сайта")
        self.assertEqual(task.industry, "IT")
        self.assertFalse(task.is_confirmed)
        self.assertFalse(task.is_published)
        self.assertEqual(task.readiness_score, 0)

    def test_task_str(self):
        task = Task.objects.create(title="Тестовая задача")

        self.assertEqual(str(task), "Тестовая задача")


