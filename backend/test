class TaskApiTest(TestCase):

    def test_create_task(self):
        data = {
            "title": "Мобильное приложение",
            "industry": "IT",
            "context": "Нужно мобильное приложение",
            "need": "Разработка приложения",
            "users": "Студенты",
            "expected_result": "Работающее приложение"
        }

        response = self.client.post(
            "/tasks/",
            data=json.dumps(data),
            content_type="application/json"
        )

        self.assertEqual(response.status_code, 201)
        self.assertEqual(Task.objects.count(), 1)

        task = Task.objects.first()

        self.assertEqual(task.title, "Мобильное приложение")
        self.assertEqual(task.industry, "IT")

    def test_create_task_invalid_json(self):
        response = self.client.post(
            "/tasks/",
            data="invalid json",
            content_type="application/json"
        )

        self.assertEqual(response.status_code, 400)
        self.assertEqual(
            response.json()["error"],
            "Invalid JSON."
        )

    def test_get_published_tasks(self):
        Task.objects.create(
            title="Опубликованная задача",
            is_published=True
        )

        Task.objects.create(
            title="Неопубликованная задача",
            is_published=False
        )

        response = self.client.get("/tasks/")

        self.assertEqual(response.status_code, 200)

        data = response.json()

        self.assertEqual(len(data["results"]), 1)
        self.assertEqual(
            data["results"][0]["title"],
            "Опубликованная задача"
        )

    def test_filter_tasks_by_industry(self):
        Task.objects.create(
            title="IT задача",
            industry="IT",
            is_published=True
        )

        Task.objects.create(
            title="Медицинская задача",
            industry="Medicine",
            is_published=True
        )

        response = self.client.get("/tasks/?industry=IT")

        self.assertEqual(response.status_code, 200)

        data = response.json()

        self.assertEqual(len(data["results"]), 1)
        self.assertEqual(data["results"][0]["industry"], "IT")


class TaskDetailApiTest(TestCase):

    def setUp(self):
        self.task = Task.objects.create(
            title="Старая задача",
            industry="IT"
        )

    def test_get_task(self):
        response = self.client.get(
            f"/tasks/{self.task.id}/"
        )

        self.assertEqual(response.status_code, 200)

        data = response.json()

        self.assertEqual(
            data["title"],
            "Старая задача"
        )

        self.assertEqual(
            data["id"],
            self.task.id
        )

    def test_update_task(self):
        data = {
            "title": "Обновленная задача",
            "industry": "Education"
        }

        response = self.client.patch(
            f"/tasks/{self.task.id}/",
            data=json.dumps(data),
            content_type="application/json"
        )

        self.assertEqual(response.status_code, 200)

        self.task.refresh_from_db()

        self.assertEqual(
            self.task.title,
            "Обновленная задача"
        )

        self.assertEqual(
            self.task.industry,
            "Education"
        )

    def test_task_not_found(self):
        response = self.client.get("/tasks/9999/")

        self.assertEqual(response.status_code, 404)


