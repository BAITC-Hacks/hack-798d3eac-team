class ProposalModelTest(TestCase):

    def test_create_proposal(self):
        task = Task.objects.create(
            title="Создание сайта",
            is_published=True
        )

        team = Team.objects.create(
            name="Alpha Team"
        )

        proposal = Proposal.objects.create(
            task=task,
            team=team,
            idea="Создадим современный сайт",
            plan="Разработаем frontend и backend",
            duration="2 месяца"
        )

        self.assertEqual(proposal.task, task)
        self.assertEqual(proposal.team, team)
        self.assertEqual(proposal.status, Proposal.Status.PENDING)

    def test_proposal_str(self):
        task = Task.objects.create(title="Создание сайта")
        team = Team.objects.create(name="Alpha Team")

        proposal = Proposal.objects.create(
            task=task,
            team=team,
            idea="Идея",
            plan="План",
            duration="1 месяц"
        )

        self.assertEqual(
            str(proposal),
            "Alpha Team → Создание сайта"
        )


